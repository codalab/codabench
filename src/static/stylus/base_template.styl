/* --------------------------------------------------------------------------------------
 misc styles for base template
 */
html
    background-color #f6f8fa

#page_content
    min-height 82vh
    margin-bottom 50px

#toast-container
    opacity 0.8
    margin-top 3em
    margin-right 0.5em

/* --------------------------------------------------------------------------------------
 Fix padding on menus
 */
.ui.menu .ui.dropdown .menu>.item
    margin-top -0.6em !important



/* --------------------------------------------------------------------------------------
 Modals
 */
.modals
    .modal
        max-height 90vh
        overflow-y scroll

