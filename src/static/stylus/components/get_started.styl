/* --------------------------------------------------------------------------------------
 Get Started component (templates/components/get_started.html)
 */
.get-started
    width 100%
    margin 3em 0

#page_content .get-started-title
    margin 0 0 1em
    color $cb-navy-900
    font-size 1.6em
    text-align left

.get-started-cards
    display grid
    grid-template-columns repeat(3, 1fr)
    gap 20px

.get-started-card
    display flex
    flex-direction column
    align-items flex-start
    padding 24px
    background-color $cb-blue-50
    border 1px solid rgba($cb-blue-500, 0.25)
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)
    text-align left
    transition transform 150ms ease, box-shadow 150ms ease

.get-started-card:hover
    border-color $cb-blue-500
    transform translateY(-3px)
    box-shadow 0 8px 20px rgba(27, 47, 64, 0.12)

.get-started-icon
    display flex
    align-items center
    justify-content center
    width 44px
    height 44px
    margin-bottom 16px
    border-radius 50%
    background-color rgba($cb-blue-500, 0.14)
    color $cb-blue-500
    font-size 18px

    .icon
        margin 0

#page_content .get-started-card-title
    margin 0 0 8px
    color $cb-navy-900
    font-size 1.15em

.get-started-text
    flex 1
    margin 0 0 20px
    color #4a4a4a
    font-size 14px
    line-height 1.55

.get-started-button
    padding 8px 16px
    border-radius 6px
    background-color $cb-blue-500
    color #fff
    font-size 14px
    font-weight 500

.get-started-button:hover
    background-color darken($cb-blue-500, 12%)
    color #fff

/* Phones and small tablets: 1 per row
   Why: with 3 cards, 2 per row would leave the third card alone on its own row */
@media only screen and (max-width 767px)
    .get-started-cards
        grid-template-columns 1fr
