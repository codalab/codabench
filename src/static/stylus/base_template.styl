/* --------------------------------------------------------------------------------------
 misc styles for base template
 */
html
    background-color #f6f8fa

// Scrollbars in the theme colors.
// Why html and body: html is the scrollbar of the page, and body covers everything inside the page.
html::-webkit-scrollbar,
body ::-webkit-scrollbar
    width 10px
    height 10px

html::-webkit-scrollbar-track,
body ::-webkit-scrollbar-track
    background transparent

html::-webkit-scrollbar-thumb,
body ::-webkit-scrollbar-thumb
    border-radius 5px
    background rgba($cb-navy-700, 0.35)

html::-webkit-scrollbar-thumb:hover,
body ::-webkit-scrollbar-thumb:hover
    background rgba($cb-navy-700, 0.6)

#page_content
    min-height 82vh
    margin-bottom 50px

#toast-container
    opacity 0.8
    margin-top 3em
    margin-right 0.5em

/* --------------------------------------------------------------------------------------
 Fix padding on menus
 */
.ui.menu .ui.dropdown .menu>.item
    margin-top -0.6em !important



/* --------------------------------------------------------------------------------------
 Modals
 */
.modals
    .modal
        max-height 90vh
        overflow-y scroll

