/* Dashboard & Analytics Stylesheet */

dashboard
    display block
    width 100%

dashboard-overview,
dashboard-tags-stats,
dashboard-table,
dashboard-data-explorer,
dashboard-competitions-table
    display block
    width 100%

.dashboard-page-container
    max-width 1440px
    margin 0 auto
    padding 15px 20px 40px 20px

.dashboard-header
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap 12px
    margin-bottom 20px

.dashboard-title-group
    flex 1
    min-width 240px

.dashboard-title
    margin 0
    font-size 24px
    font-weight bold
    color #1b1b1b
    display flex
    align-items center
    gap 10px

    i.icon
        color #43637a
        margin 0

.dashboard-subtitle
    margin 4px 0 0 0
    font-family Roboto, sans-serif
    font-size 14px
    font-weight normal
    color #64748b
    line-height 1.4

.dashboard-layout
    display flex
    align-items flex-start
    gap 20px
    width 100%

.dashboard-sidebar
    width 270px
    flex-shrink 0

.dashboard-main
    flex 1
    min-width 0

.dashboard-tabs-menu.ui.secondary.pointing.menu
    width 100% !important
    margin 0 0 24px 0 !important
    border-bottom 2px solid #e2e8f0 !important

    .item
        font-size 15px !important
        font-weight 600 !important
        color #64748b !important
        padding 14px 20px !important
        cursor pointer !important
        border-bottom 2px solid transparent !important
        text-align center !important
        margin-bottom -2px !important
        transition all 0.15s ease-in-out

        &:hover
            color #1e293b !important
            border-bottom-color #cbd5e1 !important

        &.active
            color #2185d0 !important
            border-bottom-color #2185d0 !important
            font-weight 700 !important

.dashboard-tab-pane
    width 100%

/* Overview: Stats Bar */
.dashboard-stats-bar
    display flex
    justify-content space-between
    background #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)
    padding 18px 24px
    margin-bottom 20px
    gap 16px

.dashboard-stat
    flex 1
    text-align center

    &:not(:last-child)
        border-right 1px solid #e3e7ec

.dashboard-stat-value
    font-size 26px
    font-weight bold
    color #1b1b1b
    line-height 1.1

.dashboard-stat-label
    font-size 11px
    font-weight 600
    text-transform uppercase
    letter-spacing 0.04em
    color #64748b
    margin-top 6px

/* Dashboard Grid & Chart Cards */
.dashboard-charts-grid
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 16px

.dashboard-chart-card
    background #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)
    padding 16px 18px
    min-width 0

    .chart-header
        margin-bottom 12px
        padding-bottom 8px
        border-bottom 1px solid #f1f4f7
        position relative
        z-index 10

    .chart-header-with-controls
        display flex
        justify-content space-between
        align-items center
        flex-wrap wrap
        gap 10px

    .chart-controls
        display flex
        align-items center
        flex-wrap wrap
        gap 8px
        max-width 100%

    .control-group
        display inline-flex
        align-items center
        gap 6px

    .control-label
        font-size 12px
        font-weight 600
        color #4a5568
        margin 0

    .date-range-group
        display inline-flex
        align-items center
        gap 6px
        flex-wrap nowrap
        max-width 100%

    .chart-calendar
        width 145px
        max-width 145px
        min-width 0
        position relative

        .ui.input
            width 100%
            input
                border-color #d4d4d5

    .chart-dropdown.ui.selection.dropdown
        min-width 140px
        border-color #d4d4d5

    .date-sep
        color #64748b
        font-weight 600
        font-size 14px

    .chart-clear-btn
        height 38px
        margin 0 !important

    .chart-title
        margin 0
        font-size 16px
        font-weight 700
        color #1b1b1b
        letter-spacing -0.01em

    .canvas-wrap
        position relative
        height 250px
        width 100%

.full-width,
.dashboard-chart-card.tag-category-card:last-child:nth-child(odd)
    grid-column 1 / -1

.canvas-wrap-orgs
    height 300px !important

.canvas-wrap-launches
    height 480px !important

.canvas-wrap-expanded
    height 260px !important

.canvas-wrap-heatmap
    height 380px !important

.canvas-wrap-custom
    height 380px !important

.chart-type-buttons
    .ui.button
        padding 6px 9px !important
        background #f8fafc
        border-color #e2e8f0
        color #64748b

        &:hover
            background #f1f5f9
            color #1e293b

        &.active
            background #2185d0 !important
            color #fff !important
            border-color #2185d0 !important

/* Tables & Table Cards */
.table-card
    background #fff !important
    border 1px solid #e3e7ec !important
    border-radius 10px !important
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04) !important
    margin 0 !important

.table-top-bar
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap 12px
    margin-bottom 12px

.table-scroll-wrap
    width 100%
    overflow-x auto
    -webkit-overflow-scrolling touch
    touch-action pan-x pan-y

/* Explorer / Chart Builder Card */
.explorer-card
    background #fff !important
    border 1px solid #e3e7ec !important
    border-radius 10px !important
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04) !important
    padding 18px 20px !important
    margin 0 0 20px 0 !important

.explorer-header
    margin-bottom 14px
    padding-bottom 10px
    border-bottom 1px solid #f1f4f7

.explorer-controls-grid
    display grid
    grid-template-columns repeat(4, minmax(0, 1fr))
    gap 14px
    align-items flex-end

.control-item
    display flex
    flex-direction column
    gap 6px
    min-width 0

    label
        font-size 12px
        font-weight 600
        color #4a5568
        margin 0

    .custom-dropdown.ui.selection.dropdown
        width 100%
        min-width 100%
        border-color #d4d4d5

.custom-limit-group
    display flex
    align-items center
    gap 6px
    width 100%
    min-width 0

    .custom-dropdown.ui.selection.dropdown
        min-width 0 !important
        flex 1 1 0
        width auto

    .custom-limit-input.ui.input
        flex 0 0 68px
        width 68px
        min-width 0

        input
            padding 8.5px 6px !important
            text-align center
            font-size 13px
            border-color #d4d4d5

.tabular-top-bar
    margin 16px 0 10px 0

.split-by-subcontrols
    background #f8fafc
    border 1px solid #e2e8f0
    border-radius 8px
    padding 12px 14px
    margin-top 14px

.split-by-header
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap 10px
    margin-bottom 8px

.split-by-title
    font-size 13px
    font-weight 600
    color #334155
    display inline-flex
    align-items center
    gap 6px

    strong
        color #0f172a

    .split-by-count
        font-size 11.5px
        font-weight normal
        color #64748b
        margin-left 4px

.split-by-actions
    display inline-flex
    align-items center
    gap 6px

    .ui.button
        padding 5px 8px !important
        font-size 11px !important
        background #fff !important
        border-color #d1d5db !important

        &:hover
            background #f1f5f9 !important

.split-by-pills
    display flex
    flex-wrap wrap
    gap 6px
    max-height 120px
    overflow-y auto
    padding 2px

    .tag-pill
        display inline-flex
        align-items center
        gap 4px
        padding 4px 9px
        font-size 12px
        font-weight 500
        line-height 1.2
        color #36536d
        background-color #fff
        border 1px solid #cbd5e1
        border-radius 6px
        cursor pointer
        transition all 0.15s ease-in-out
        user-select none
        outline none
        box-shadow none

        &:hover
            background-color #f1f5f9
            border-color #94a3b8
            color #1e293b

        &.active
            background-color #43637a !important
            border-color #43637a !important
            color #fff !important

            .tag-pill-name
                color #fff

            .tag-pill-count
                background-color rgba(255, 255, 255, 0.25)
                color #fff

        .tag-pill-name
            white-space normal
            word-break break-word

        .tag-pill-count
            font-size 10px
            line-height 1
            padding 2px 5px
            border-radius 4px
            background-color #e2e8f0
            color #475569
            font-weight 600
            margin-left 2px

.custom-tabular-wrap
    width 100%
    border 1px solid #e3e7ec
    border-radius 8px
    overflow auto
    background #fff
    -webkit-overflow-scrolling touch
    touch-action pan-x pan-y

    table
        margin 0 !important

        thead th
            white-space nowrap
            user-select none

            i.icon
                font-size 11px
                margin-left 4px
                opacity 0.6
                transition opacity 0.15s ease

            &:hover i.icon
                opacity 1

/* Responsive Queries */
@media (max-width 991px)
    .dashboard-chart-card .chart-header-with-controls
        flex-direction column
        align-items flex-start
        gap 10px

    .dashboard-chart-card .chart-controls
        width 100%
        justify-content flex-start

    .explorer-controls-grid
        grid-template-columns repeat(2, minmax(0, 1fr))

@media (max-width 768px)
    .dashboard-layout
        flex-direction column

    .dashboard-sidebar
        width 100%

    .dashboard-tabs-menu.ui.secondary.pointing.menu
        overflow-x auto
        flex-wrap nowrap !important

        .item
            font-size 13.5px !important
            padding 10px 14px !important
            white-space nowrap !important
            flex 1 0 auto !important

    .dashboard-stats-bar
        display grid
        grid-template-columns repeat(2, 1fr)
        padding 14px 16px
        gap 12px

    .dashboard-stat
        border-right none !important
        padding 8px 0

        &:nth-child(odd)
            border-right 1px solid #e3e7ec !important

    .dashboard-stat-value
        font-size 22px

    .dashboard-charts-grid
        grid-template-columns 1fr

    .canvas-wrap-launches
        height 340px !important

    .canvas-wrap-custom
        height 320px !important

    .canvas-wrap-heatmap
        height 320px !important

@media (max-width 576px)
    .explorer-controls-grid
        grid-template-columns minmax(0, 1fr)

    .table-top-bar
        flex-direction column
        align-items stretch !important
        gap 10px

        .ui.button
            width 100%
            margin 0 !important
            text-align center
            justify-content center

    .dashboard-chart-card .date-range-group
        flex-wrap wrap

    .dashboard-chart-card .chart-calendar
        width 100%
        max-width 100%

    .dashboard-chart-card .canvas-wrap
        height 220px !important

    .canvas-wrap-orgs
        height 250px !important

    .canvas-wrap-launches
        height 280px !important

    .canvas-wrap-expanded
        height 230px !important

    .canvas-wrap-custom
        height 280px !important

@media (max-width 480px)
    .dashboard-stats-bar
        grid-template-columns 1fr
        gap 8px
        padding 12px 14px

    .dashboard-stat
        border-right none !important
        padding 6px 0

        &:not(:first-child)
            border-top 1px solid #e3e7ec !important
