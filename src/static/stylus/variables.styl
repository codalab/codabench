/* --------------------------------------------------------------------------------------
 Codabench colors

 Use the stylus variables in .styl files and the CSS variables (var(--cb-...))
 in riot tags and templates.
 */

// Navy (backgrounds)
$cb-navy-900 = #1b2f40
$cb-navy-800 = #263f54
$cb-navy-700 = #36536d

// Blue (accent)
$cb-blue-500 = #3b6e9b
$cb-blue-400 = #4789c2
$cb-blue-50 = #eef4fa

// Text
$cb-text-on-dark = #eef3f7
$cb-text-muted-on-dark = #a9bccb

// Page
$cb-page-bg = #f6f8fa

// Levels (announcements, alerts, status labels)
$cb-info = $cb-blue-500
$cb-warning = #d9902f
$cb-danger = #c9483b

// Light backgrounds for the levels
$cb-info-bg = $cb-blue-50
$cb-warning-bg = #fdf5ea
$cb-danger-bg = #fbeeec

:root
    --cb-navy-900 $cb-navy-900
    --cb-navy-800 $cb-navy-800
    --cb-navy-700 $cb-navy-700
    --cb-blue-500 $cb-blue-500
    --cb-blue-400 $cb-blue-400
    --cb-blue-50 $cb-blue-50
    --cb-text-on-dark $cb-text-on-dark
    --cb-text-muted-on-dark $cb-text-muted-on-dark
    --cb-page-bg $cb-page-bg
    --cb-info $cb-info
    --cb-warning $cb-warning
    --cb-danger $cb-danger
    --cb-info-bg $cb-info-bg
    --cb-warning-bg $cb-warning-bg
    --cb-danger-bg $cb-danger-bg
