/* --------------------------------------------------------------------------------------
 Header component (templates/components/header.html)
 */
#header
    margin-bottom 20px
    color $cb-text-on-dark
    background-color $cb-navy-900
    // Dot pattern on top of a navy gradient
    background-image radial-gradient(rgba(255, 255, 255, 0.10) 1px, transparent 1px), linear-gradient(135deg, $cb-navy-900 0%, $cb-navy-800 55%, $cb-navy-700 100%)
    background-size 20px 20px, cover

.header-inner
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    gap 1em
    padding 20px 64px

/* Logo + tagline */
.header-brand
    text-align left

#header-logo
    display block
    height 36px

.header-logo-row
    display flex
    align-items flex-end
    gap 10px

// Version tag next to the logo
.header-version
    padding 2px 8px
    border 1px solid rgba(255, 255, 255, 0.2)
    border-radius 999px
    background-color rgba(255, 255, 255, 0.08)
    color $cb-text-muted-on-dark
    font-family monospace
    font-size 12px
    line-height 1.4

.header-version:hover
    color $cb-text-on-dark
    background-color rgba(255, 255, 255, 0.16)

#header .header-tagline
    margin 8px 0 0
    color $cb-text-muted-on-dark
    font-size 14px
    font-weight normal

/* Menu */
.header-nav
    display flex
    align-items center
    flex-wrap wrap
    gap 4px

.header-link
    display flex
    align-items center
    gap 6px
    padding 8px 12px
    border-radius 6px
    color $cb-text-on-dark
    font-size 14px
    line-height 1.2

    &:hover
        background-color rgba(255, 255, 255, .12)
        color $cb-text-on-dark

    .icon
        margin 0

// Login / Sign-up buttons
.header-button
    background-color rgba(255, 255, 255, .12)

    &:hover
        background-color rgba(255, 255, 255, .25)
        color #fff

/* User menu: the panel opens below the username */
.user-menu
    position relative

.user-menu-button
    border none
    background none
    font-family inherit
    cursor pointer

.user-menu-panel
    display none
    position absolute
    top calc(100% + 6px)
    right 0
    z-index 100
    min-width 210px
    max-height 80vh
    padding 6px
    overflow-y auto
    border 1px solid rgba($cb-navy-900, 0.1)
    border-radius 6px
    background-color #fff
    box-shadow 0 8px 20px rgba($cb-navy-900, 0.12)

// Added in static/js/ours/init.js
.user-menu-open .user-menu-panel
    display block

/* Mobile menu button (shown on small screens only) */
#hamburger_button
    display none
    padding 10px 12px
    border none
    border-radius 6px
    background-color rgba(255, 255, 255, .12)
    color $cb-text-on-dark
    cursor pointer

    &:hover
        background-color rgba(255, 255, 255, .25)
        color #fff

    .icon
        margin 0

/* Small screens: menu moves into the mobile menu */
@media only screen and (max-width 625px)
    .header-inner
        flex-wrap nowrap
        padding 16px

    .header-nav
        display none

    #hamburger_button
        display block
