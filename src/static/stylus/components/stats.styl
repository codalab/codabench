/* --------------------------------------------------------------------------------------
 Stats component (templates/components/stats.html)
 Classes are prefixed with home- because stat-value / stat-label are used elsewhere.
 */
// Sits inside the About section, between the intro and the columns
.home-stats-section
    width 100%
    margin 1.5em 0 0

.home-stats
    display grid
    grid-template-columns repeat(3, 1fr)
    width 100%
    margin 0
    padding 24px 0
    // Same white card as the About columns below it
    background-color #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)

.home-stat
    padding 0 12px
    text-align center
    border-left 1px solid #e3e7ec

    &:first-child
        border-left none

// Why: a fixed size, so it does not change with the About section's font size
.home-stat-value
    color $cb-navy-900
    font-size 28px
    font-weight 700
    line-height 1.1

// Same look as the feature card text
.home-stat-label
    margin-top 6px
    color #5a5a5a
    font-size 13px

/* Tablets and phones: one stat per row, dividers go between rows */
// Why: two columns would leave the last stat alone on its own row, and three are too narrow for big numbers
@media only screen and (max-width 767px)
    .home-stats
        grid-template-columns 1fr
        gap 20px

    .home-stat
        border-left none

        &:not(:first-child)
            padding-top 20px
            border-top 1px solid #e3e7ec
