/* --------------------------------------------------------------------------------------
 About component (templates/components/about.html)
 */
.about
    width 100%
    margin 3em 0
    color #4a4a4a
    font-size 15px
    line-height 1.65
    text-align left

    p
        margin 0 0 1em

#page_content .about-title
    margin 0 0 0.6em
    color $cb-navy-900
    font-size 1.6em

.about-intro
    max-width 820px
    font-size 17px
    color #2e2e2e

.about-columns
    display grid
    grid-template-columns 1fr 1fr
    gap 20px
    margin 2em 0 20px

// Each column is a white card, matching the stats panel below
.about-column
    padding 24px
    background-color #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)

    p:last-child
        margin-bottom 0

#page_content .about-subtitle
    margin 0 0 0.8em
    color $cb-navy-900
    font-size 1.1em

.about-features
    margin 0
    padding 0
    list-style none

    li
        display flex
        gap 10px
        margin-bottom 10px

    li:last-child
        margin-bottom 0

    .icon
        flex none
        margin 0
        color $cb-blue-500

/* Phones: columns stack */
@media only screen and (max-width 767px)
    .about-columns
        grid-template-columns 1fr
