/* --------------------------------------------------------------------------------------
 Stats component (templates/components/stats.html)
 Classes are prefixed with home- because stat-value / stat-label are used elsewhere.
 */
// Sits inside the About section, between the intro and the columns
.home-stats-section
    width 100%
    margin 1.5em 0 0

// Small muted line instead of a heading
// Why: two selectors so it wins over the About section's paragraph margin
.home-stats-section .home-stats-caption
    margin 0 0 10px
    color #6b7785
    font-size 14px
    text-align left

.home-stats
    display grid
    grid-template-columns repeat(5, 1fr)
    width 100%
    margin 0
    padding 24px 0
    // Same white card as the About columns below it
    background-color #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)

.home-stat
    padding 0 12px
    text-align center
    border-left 1px solid #e3e7ec

    &:first-child
        border-left none

// Why: a fixed size, so it does not change with the About section's font size
.home-stat-value
    color $cb-blue-500
    font-size 28px
    font-weight 700
    line-height 1.1

// Same look as the feature card text
.home-stat-label
    margin-top 6px
    color #5a5a5a
    font-size 13px

/* Tablets and phones: two per row, dividers become row spacing */
@media only screen and (max-width 767px)
    .home-stats
        grid-template-columns repeat(2, 1fr)
        row-gap 24px
        padding 24px 0

    .home-stat
        border-left none
