/* --------------------------------------------------------------------------------------
 Mobile menu component (templates/components/mobile_menu.html)
 The bottom part uses the shared items from user_menu.styl.
 */

// Hidden off the right side of the screen until opened
.mobile-menu
    position fixed
    top 0
    right 0
    bottom 0
    z-index 101
    width 280px
    max-width 85vw
    overflow-y auto
    background-color #fff
    box-shadow 0 8px 20px rgba($cb-navy-900, 0.12)
    visibility hidden
    transform translateX(100%)
    transition transform 200ms ease, visibility 200ms

// Dims the page behind the menu. Clicking it closes the menu
.mobile-menu-backdrop
    position fixed
    inset 0
    z-index 100
    background-color rgba($cb-navy-900, 0.5)
    opacity 0
    visibility hidden
    transition opacity 200ms ease, visibility 200ms

// Added to the body in static/js/ours/init.js
body.mobile-menu-open
    overflow hidden

    .mobile-menu
        visibility visible
        transform none

    .mobile-menu-backdrop
        opacity 1
        visibility visible

/* Top part: same dark look as the header, because these are the header links */
.mobile-menu-top
    background-color $cb-navy-900

.mobile-menu-link
    display flex
    align-items center
    gap 8px
    padding 12px 16px
    color $cb-text-on-dark
    font-size 14px

    .icon
        margin 0

a.mobile-menu-link:hover
    background-color rgba(255, 255, 255, .08)
    color $cb-text-on-dark

.mobile-menu-user
    border-top 1px solid rgba(255, 255, 255, .1)
    font-weight bold

/* Bottom part */
.mobile-menu-items
    padding 6px
