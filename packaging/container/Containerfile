FROM almalinux:10-minimal AS builder

# Ask the AlmaLinux mirrorlist for HTTPS mirrors only. By default it returns
# plain-http mirrors, so packages and repo metadata would travel unencrypted.
RUN sed -i -E '/^mirrorlist=/{/\?/!s|$|?protocol=https|}' /etc/yum.repos.d/*.repo \
    && microdnf update -y --nodocs && microdnf install -y tar gzip &&  microdnf clean all

FROM scratch

COPY --from=builder / /

ENV PYTHONUNBUFFERED=1

# Install UV and add paths to PATH for uv and the future .venv created by uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && microdnf remove -y tar gzip && microdnf clean all
ENV PATH=$PATH:/root/.local/bin
ENV PATH=$PATH:/.venv/bin

# Copy pyproject and uv.lock
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --all-extras --frozen

WORKDIR /app
ENTRYPOINT ["/bin/bash", "-c"]
