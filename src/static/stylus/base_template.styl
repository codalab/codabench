/* --------------------------------------------------------------------------------------
 misc styles for base template
 */
html
    background-color #f6f8fa

#user_dropdown
    color rgba(255,255,255,.7) !important

    a
        width 100%
        border-radius 0 !important

#page_content
    min-height 82vh
    margin-bottom 50px

#toast-container
    opacity 0.8
    margin-top 3em
    margin-right 0.5em

/* --------------------------------------------------------------------------------------
 Force the footer to stretch all the way to the bottom of viewport
 */
body.pushable>.pusher
    background-color #f6f8fa !important
    overflow initial

.pushable
    height 0

.pusher > .footer
    flex 1

/* --------------------------------------------------------------------------------------
 Fix padding on menus
 */
.ui.menu .ui.dropdown .menu>.item
    margin-top -0.6em !important



/* --------------------------------------------------------------------------------------
 Modals
 */
.modals
    .modal
        max-height 90vh
        overflow-y scroll

