/* --------------------------------------------------------------------------------------
 Benchmarks components (templates/components/benchmarks.html and benchmark_card.html)
 */

/* Sections */
.hb-section
    width 100%
    margin 3em 0
    text-align left

.hb-header
    display flex
    justify-content space-between
    align-items baseline
    flex-wrap wrap
    gap 8px
    margin-bottom 1em

#page_content .hb-title
    margin 0
    color $cb-navy-900
    font-size 1.6em

.hb-view-all
    color $cb-blue-500
    font-weight 500

    &:hover
        color $cb-blue-400

    .icon
        margin 0 0 0 2px

// minmax(0, 1fr) keeps columns equal even with long content
.hb-grid
    display grid
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap 20px

.hb-empty
    margin 0
    color #6b7785
    font-size 14px

/* Card */
.bc-card
    position relative
    display flex
    flex-direction column
    gap 10px
    min-width 0
    height 100%
    padding 20px
    background-color #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)
    text-align left
    // Why: the tags section reaches the card edges, and the corners must stay round
    overflow hidden
    transition transform 150ms ease, box-shadow 150ms ease

    &:hover
        border-color $cb-blue-500
        transform translateY(-3px)
        box-shadow 0 8px 20px rgba(27, 47, 64, 0.12)

// Featured: blue stripe on top (kept on hover)
.bc-featured,
.bc-featured:hover
    border-top 3px solid $cb-blue-500

// Makes the whole card clickable
.bc-stretched
    position absolute
    inset 0
    z-index 1
    border-radius 10px

.bc-top
    display flex
    gap 12px
    align-items flex-start

.bc-logo
    flex none
    display flex
    align-items center
    justify-content center
    width 52px
    height 52px
    overflow hidden
    border-radius 10px
    border 1px solid rgba($cb-blue-500, 0.25)
    background linear-gradient(135deg, $cb-blue-500, $cb-blue-400)
    color #fff
    font-size 20px
    font-weight 700

    // Fill the whole square (edges of non-square logos are cropped)
    img
        width 100%
        height 100%
        object-fit cover
        background-color #fff

.bc-head
    flex 1
    min-width 0

// Featured and type, above the title
.bc-labels
    display flex
    flex-wrap wrap
    gap 6px
    margin-bottom 6px

.bc-type,
.bc-featured-pill
    padding 2px 8px
    border-radius 999px
    font-size 11px
    font-weight 600
    letter-spacing 0.05em
    text-transform uppercase

.bc-type
    background-color $cb-blue-50
    color $cb-blue-500

.bc-featured-pill
    background-color $cb-blue-500
    color #fff

// Always 2 lines, longer titles end with "..."
#page_content .bc-title
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 2
    overflow hidden
    min-height 2.6em
    margin 0
    color $cb-navy-900
    font-size 16px
    font-weight 700
    line-height 1.3

.bc-desc
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 2
    overflow hidden
    margin 0
    color #4a4a4a
    font-size 14px
    line-height 1.55

/* Under the description: the organizer on one line, the date, numbers and prize on the next */
.bc-meta
    display flex
    flex-direction column
    gap 8px
    // Why: pushes the organizer, pills and tags to the bottom, so they line up across cards of one row
    margin-top auto

// A long organizer name is cut with "..."
.bc-organizer
    display flex
    align-items center
    gap 8px
    min-width 0

// Round avatar: the profile photo, or the first letter of the name
.bc-avatar
    flex none
    display flex
    align-items center
    justify-content center
    width 22px
    height 22px
    overflow hidden
    border-radius 50%
    background-color $cb-blue-50
    color $cb-blue-500
    font-size 11px
    font-weight 700

    img
        width 100%
        height 100%
        object-fit cover

.bc-organizer-name
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    color $cb-blue-500
    font-size 13px

.bc-pills
    display flex
    flex-wrap wrap
    gap 6px

.bc-pill
    display inline-flex
    align-items center
    gap 4px
    padding 3px 9px
    border-radius 999px
    background-color #f1f4f7
    color $cb-navy-700
    font-size 12px
    white-space nowrap
    // Why: above the link that covers the card, so hovering a pill shows what it is.
    // Clicking a pill does not open the competition, the space around it still does.
    position relative
    z-index 2
    // Why: without it the browser shows the text cursor, now that the pill is above the link
    cursor default

    .bi
        font-size 11px

// Prize stands out in amber (after .bc-pill so its colors win)
.bc-prize
    background-color $cb-warning-bg
    color #a8691f
    font-weight 500

    .bi
        color $cb-warning

/* Tags: a white section at the bottom of the card, edge to edge, under a line */
.bc-tag-section
    // Why: the card has 20px of padding, the negative margins reach its edges
    margin 0 -20px -20px
    padding 10px 20px
    border-top 1px solid #e3e7ec
    background-color #fff
    // Why: above the link that covers the card, so hovering a tag or "+N more" shows its text.
    // Clicking in this section does not open the competition.
    position relative
    z-index 2
    // Why: without it the browser shows the text cursor over the tags
    cursor default

// One line. card_tags.js hides the tags that do not fit and shows "+N more".
.bc-tag-row
    display flex
    align-items center
    gap 6px
    min-width 0
    overflow hidden

.bc-tag-icon
    flex none
    color #6b7785
    font-size 12px

// Square corners, so the tags do not look like the round pills above
.bc-tag
    flex none
    padding 2px 8px
    border-radius 4px
    background-color #f1f4f7
    color $cb-navy-700
    font-size 12px
    line-height 18px
    white-space nowrap

// A tag the visitor filters by, so they see why the card is in the list
.bc-tag-match
    background-color $cb-blue-50
    color $cb-blue-500
    font-weight 500

// When only one tag is left and it is still too long, it is cut with "..."
.bc-tag-alone
    flex 0 1 auto
    min-width 0
    overflow hidden
    text-overflow ellipsis

.bc-tag-more
    flex none
    color #6b7785
    font-size 12px
    font-weight 500
    white-space nowrap

// Why: the display rules above would show them even with the hidden attribute
.bc-tag[hidden],
.bc-tag-more[hidden]
    display none

.bc-tag-empty
    color #6b7785
    font-size 12px

/* Tablets: 2 per row, phones: 1 per row */
@media only screen and (max-width 991px)
    .hb-grid
        grid-template-columns repeat(2, minmax(0, 1fr))

@media only screen and (max-width 625px)
    .hb-grid
        grid-template-columns minmax(0, 1fr)
