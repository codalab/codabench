/* --------------------------------------------------------------------------------------
 News component (templates/components/news.html)
 */
.news-section
    width 100%
    margin 3em 0
    text-align left

.news-section-header
    display flex
    justify-content space-between
    align-items baseline
    flex-wrap wrap
    gap 8px
    margin-bottom 1em

#page_content .news-section-title
    margin 0
    color $cb-navy-900
    font-size 1.6em

.news-view-all
    color $cb-blue-500
    font-weight 500

    &:hover
        color $cb-blue-400

    .icon
        margin 0 0 0 2px

.news-cards
    display grid
    grid-template-columns repeat(3, 1fr)
    gap 20px

.news-card
    display flex
    flex-direction column
    padding 24px
    background-color #fff
    border 1px solid #e3e7ec
    border-radius 10px
    box-shadow 0 1px 2px rgba(0, 0, 0, 0.04)

// Date pill, e.g. "SEP 23, 2026"
.news-card-date
    align-self flex-start
    margin-bottom 12px
    padding 3px 10px
    border-radius 999px
    background-color $cb-blue-50
    color $cb-blue-500
    font-size 12px
    font-weight 500
    line-height 1.4
    letter-spacing 0.06em
    text-transform uppercase

#page_content .news-card-title
    margin 0 0 10px
    color $cb-navy-900
    font-size 1.1em

    a
        color inherit

    a:hover
        color $cb-blue-500

// Max 3 lines, with "..." at the end of the 3rd
.news-card-text
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp 3
    line-clamp 3
    overflow hidden
    margin 0
    color #4a4a4a
    font-size 14px
    line-height 1.55

// Expanded card shows the full text
.news-card-expanded .news-card-text
    display block
    -webkit-line-clamp unset
    line-clamp unset

// "Read more" on the left, "Open link" on the right, at the bottom of the card
.news-card-actions
    display flex
    justify-content space-between
    align-items center
    gap 12px
    margin-top auto
    padding-top 10px

// "Read more" / "Show less" (a button, it does not leave the page)
.news-card-toggle
    padding 0
    border none
    background none
    color $cb-blue-500
    font inherit
    font-size 14px
    font-weight 500
    cursor pointer

    &:hover
        color $cb-blue-400

    .icon
        margin 0

// Keeps "Open link" on the right when "Read more" is hidden
.news-card-link
    margin-left auto
    color $cb-blue-500
    font-size 14px
    font-weight 500

    &:hover
        color $cb-blue-400

    .icon
        margin 0 0 0 2px

/* Tablets and phones: one per row */
@media only screen and (max-width 767px)
    .news-cards
        grid-template-columns 1fr
